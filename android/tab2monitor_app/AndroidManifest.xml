<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab2Monitor - APK nativa (sostituisce la dashboard nel browser)
  Versione: v0.10.0 - 2026-10-22 02:30 (branch installer: minSdk 21 = Android 5.0+; ACCESS_WIFI_STATE e
  CHANGE_WIFI_MULTICAST_STATE per la scoperta del server via UDP broadcast)
  Versione precedente: v0.6.0 - 2026-10-22 02:00  (v0.6.0: presenza con fotocamera frontale - CAMERA, WAKE_LOCK,
  PresenceService, AdminReceiver; v0.5.0: box per hardware - manifest invariato; v0.4.0: pagine, GPU multiple, ventole, icone - manifest invariato; v0.3.0: pannello Claude; v0.2.0: + SettingsActivity; v0.1.0 - 2026-10-21 23:50)
  Target: Galaxy Tab 2 10.1 GT-P5100, LineageOS 14.1 (Android 7.1.2, SDK 25).
  Scelte per la poca RAM:
    - nessuna libreria (niente AppCompat/AndroidX), nessun layout XML: tutto su un Canvas
    - tema di sistema Black.NoTitleBar.Fullscreen, niente anteprima di avvio
    - orientamento "landscape" fisso: non serve l'accelerometro (WindowOrientationListener)
  versionCode / versionName vengono imposti dallo script di build (aapt2 link).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="it.tab2revamp.monitor">

    <!-- v0.10.0: minSdk 21 (era 25); targetSdk resta 25 (vedi PIANO_INSTALLER) -->
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="25" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v0.10.0: scoperta del server (Discovery): broadcast della sottorete e MulticastLock -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v0.6.0: rilevamento presenza (fotocamera frontale) e accensione/spegnimento schermo.
         CAMERA e' un permesso "runtime": lo chiede la schermata impostazioni (o adb pm grant). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:label="Tab2Monitor"
        android:icon="@drawable/ic"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2026-10-22 v0.2.0: pannello impostazioni (pressione lunga sulla dashboard).
             Tema Material scuro di sistema: interruttori e campi senza librerie. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="Tab2Monitor - impostazioni"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Modalita' "kiosk" opzionale: Tab2Monitor come schermata Home.
             Disattivata di default; si attiva con
             adb shell pm enable it.tab2revamp.monitor/.HomeAlias
             (vedi install_tab2monitor_*.sh -home). -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- v0.6.0: servizio di presenza e amministratore dispositivo (solo lockNow) -->
        <service android:name=".PresenceService" android:exported="false" />
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Avvio al boot (funziona solo dopo il primo avvio manuale dell'app:
             finche' non e' mai stata aperta Android la tiene in stato "stopped"). -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
